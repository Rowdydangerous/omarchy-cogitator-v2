#!/bin/bash
# cogitator-v2 — lifecycle wrapper around NATIVE Omarchy installs.
#
# This repo root is simultaneously:
#   * a plugin root (manifest.json + qml/) for `omarchy plugin add <url>`
#   * a theme root (colors.toml + shell.toml + backgrounds/ + icons.theme)
#     for `omarchy theme install <url>` (theme slug derives from repo name;
#     this wrapper pins the curated slug `cogitator-green`)
#
# The wrapper adds what native commands don't: a snapshot (previous theme +
# background + shell.json backup) before anything mutates, so disable
# restores exactly. User-space only:
#   ~/.config/omarchy/plugins/cogitator-rite/
#   ~/.config/omarchy/themes/cogitator-green/
#   ~/.config/cogitator-v2/
#   ~/.local/state/cogitator-v2/
#
# Theme switches relaunch the shell and restart terminals — including the
# invoking shell — so enable/disable queue a detached transient unit and
# return immediately. Poll with `cogitator status`.
set -euo pipefail

readonly VERSION="0.3.0"
readonly PLUGIN_ID="cogitator-rite"
readonly THEME_SLUG="cogitator-green"
readonly MARKER=".cogitator-v2-installed"
readonly HERALD_MARKER=".cogitator-v2-herald"
readonly HERALD_SOURCE="omarchy.notifications"
readonly MENU_MARKER=".cogitator-v2-menu"
readonly MENU_SOURCE="omarchy.menu"

SOURCE_DIR=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
readonly SOURCE_DIR
readonly REPO_URL="file://$SOURCE_DIR"
readonly CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly CONFIG_DIR="$CONFIG_HOME/cogitator-v2"
readonly CONF_FILE="$CONFIG_DIR/cogitator.conf"
readonly CONFIG_JSON="$CONFIG_DIR/config.json"
readonly STATE_DIR="$STATE_HOME/cogitator-v2"
readonly SNAPSHOT="$STATE_DIR/snapshot.json"
readonly BACKUP_ROOT="$STATE_DIR/backups"
readonly PLUGIN_DST="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
readonly THEME_DST="$HOME/.config/omarchy/themes/$THEME_SLUG"
readonly SHELL_JSON="$HOME/.config/omarchy/shell.json"

fail() { printf 'cogitator: %s\n' "$*" >&2; exit 1; }

current_theme() { omarchy theme current 2>/dev/null || true; }

plugin_known() {
  omarchy-shell shell listPlugins 2>/dev/null \
    | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id)' >/dev/null 2>&1
}

plugin_enabled() {
  omarchy-shell shell listPlugins 2>/dev/null \
    | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id and .enabled == true)' >/dev/null 2>&1
}

# Ours if we installed it (marker receipt) or it clones this repo.
owned_by_us() {
  local dir="$1"
  [[ -f $dir/$MARKER ]] && return 0
  [[ -d $dir/.git ]] || return 1
  [[ $(git -C "$dir" config --get remote.origin.url 2>/dev/null) == "$REPO_URL" ]]
}

# ID of the installed clone for a built-in source (clonedFrom routing), if any.
find_clone() {
  omarchy-shell shell listPlugins 2>/dev/null \
    | jq -r --arg src "$1" '[.[] | select(.clonedFrom == $src) | .id][0] // ""'
}

find_herald_clone() { find_clone "$HERALD_SOURCE"; }
find_menu_clone() { find_clone "$MENU_SOURCE"; }

write_snapshot() {
  local previous="$1" previous_bg
  previous_bg=$(omarchy theme bg current 2>/dev/null || true)
  mkdir -p "$STATE_DIR" "$BACKUP_ROOT"
  local backup=""
  if [[ -f $SHELL_JSON ]]; then
    backup="$BACKUP_ROOT/shell-$(date +%Y%m%d-%H%M%S).json"
    cp -a -- "$SHELL_JSON" "$backup"
  fi
  local herald_clone herald_backup="" menu_clone menu_backup=""
  herald_clone=$(find_herald_clone)
  if [[ -n $herald_clone && -d $HOME/.config/omarchy/plugins/$herald_clone ]]; then
    herald_backup="$BACKUP_ROOT/notifications-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$herald_backup"
    cp -a -- "$HOME/.config/omarchy/plugins/$herald_clone/Service.qml" \
      "$HOME/.config/omarchy/plugins/$herald_clone/components/NotificationCard.qml" \
      "$herald_backup/"
  fi
  menu_clone=$(find_menu_clone)
  if [[ -n $menu_clone && -d $HOME/.config/omarchy/plugins/$menu_clone ]]; then
    menu_backup="$BACKUP_ROOT/menu-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$menu_backup"
    cp -a -- "$HOME/.config/omarchy/plugins/$menu_clone/Menu.qml" \
      "$menu_backup/"
  fi
  jq -n --arg v "$VERSION" --arg prev "$previous" --arg prevBg "$previous_bg" \
    --arg backup "$backup" --arg heraldClone "$herald_clone" --arg heraldBackup "$herald_backup" \
    --arg menuClone "$menu_clone" --arg menuBackup "$menu_backup" \
    '{version: $v, previousTheme: $prev, previousBackground: $prevBg, shellBackup: $backup, heraldClone: $heraldClone, heraldBackup: $heraldBackup, menuClone: $menuClone, menuBackup: $menuBackup}' \
    > "$SNAPSHOT.tmp"
  mv "$SNAPSHOT.tmp" "$SNAPSHOT"
}

# Render ~/.config/cogitator-v2/config.json from cogitator.conf.
render_config_json() {
  [[ -f $CONF_FILE ]] || fail "missing $CONF_FILE"
  python3 - "$CONF_FILE" "$CONFIG_JSON" <<'EOF'
import json, sys

CONF, OUT = sys.argv[1], sys.argv[2]

def boolean(value, default):
    value = value.strip().lower()
    if value in ("true", "yes", "1"):
        return True
    if value in ("false", "no", "0"):
        return False
    return default

def number(value, default, lo, hi):
    try:
        parsed = float(value.strip().strip('"'))
    except ValueError:
        return default
    return min(hi, max(lo, parsed))

raw = {}
with open(CONF) as handle:
    for line in handle:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        raw[key.strip()] = value.strip().strip('"')

config = {
    "palette": raw.get("PALETTE", "green").lower(),
    "propEnabled": boolean(raw.get("COGITATOR_PROP", "true"), True),
    "propPosition": raw.get("COGITATOR_PROP_POSITION", "right").lower(),
    "propOpacity": number(raw.get("COGITATOR_PROP_OPACITY", "0.92"), 0.92, 0.4, 1.0),
    "burnEnabled": boolean(raw.get("BACKGROUND_BURN", "true"), True),
    "burnOpacity": number(raw.get("BACKGROUND_BURN_OPACITY", "0.08"), 0.08, 0.0, 0.3),
    "animationLevel": raw.get("ANIMATION_LEVEL", "full").lower(),
    "textStreaming": boolean(raw.get("TEXT_STREAMING", "true"), True),
    "workspaceRites": boolean(raw.get("WORKSPACE_RITES", "true"), True),
    "crtEnabled": boolean(raw.get("CRT_ENABLED", "true"), True),
    "crtGlobal": boolean(raw.get("CRT_GLOBAL", "true"), True),
    "windowChamfer": boolean(raw.get("WINDOW_CHAMFER", "true"), True),
    "windowCorner": int(number(raw.get("WINDOW_CORNER", "14"), 14, 0, 40)),
    "crtIntensity": number(raw.get("CRT_INTENSITY", "0.25"), 0.25, 0.0, 1.0),
    "flicker": number(raw.get("FLICKER", "0.05"), 0.05, 0.0, 0.3),
    "noise": number(raw.get("NOISE", "0.03"), 0.03, 0.0, 0.3),
    "persistence": number(raw.get("PERSISTENCE", "0.15"), 0.15, 0.0, 1.0),
    "ghosting": number(raw.get("GHOSTING", "0.10"), 0.10, 0.0, 1.0),
    "screenBurn": boolean(raw.get("SCREEN_BURN", "false"), False),
    "brightnessFalloff": boolean(raw.get("BRIGHTNESS_FALLOFF", "true"), True),
}
if config["propPosition"] not in ("left", "right"):
    config["propPosition"] = "right"
if config["animationLevel"] not in ("full", "normal", "minimal"):
    config["animationLevel"] = "full"

with open(OUT, "w") as handle:
    json.dump(config, handle, indent=2)
    handle.write("\n")
EOF
}

readonly BINDINGS_FILE="$HOME/.config/hypr/bindings.lua"
readonly BIND_BEGIN="-- cogitator-v2-super-space-begin"
readonly BIND_END="-- cogitator-v2-super-space-end"
readonly HYPR_LUA="$HOME/.config/hypr/looknfeel.lua"
readonly CRT_BEGIN="-- cogitator-v2-crt-begin"
readonly CRT_END="-- cogitator-v2-crt-end"
readonly CHAMFER_BEGIN="-- cogitator-v2-chamfer-begin"
readonly CHAMFER_END="-- cogitator-v2-chamfer-end"
readonly CRT_FRAG="$CONFIG_DIR/crt.frag"

conf_value() {
  local key="$1" fallback="$2" value
  value=$(awk -F= -v key="$key" '
    $1 ~ "^[[:space:]]*" key "[[:space:]]*$" {
      value=$0
      sub(/^[^=]*=[[:space:]]*/, "", value)
      sub(/[[:space:]]*#.*$/, "", value)
      gsub(/^[[:space:]\"]+|[[:space:]\"]+$/, "", value)
      print value
      exit
    }
  ' "$CONF_FILE" 2>/dev/null || true)
  printf '%s\n' "${value:-$fallback}"
}

set_conf() {
  local key="$1" value="$2"
  [[ -f $CONF_FILE ]] || fail "missing $CONF_FILE"
  awk -v key="$key" -v value="$value" '
    BEGIN { replaced=0 }
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      if (!replaced) print key "=\"" value "\""
      replaced=1
      next
    }
    { print }
    END { if (!replaced) print key "=\"" value "\"" }
  ' "$CONF_FILE" > "$CONF_FILE.tmp"
  mv "$CONF_FILE.tmp" "$CONF_FILE"
}

render_crt_frag() {
  local intensity scan vig
  intensity=$(conf_value CRT_INTENSITY 0.25)
  [[ $intensity =~ ^[0-9]+([.][0-9]+)?$ ]] || intensity=0.25
  scan=$(awk -v v="$intensity" 'BEGIN { printf "%.3f", v * 0.4 }')
  vig=$(awk -v v="$intensity" 'BEGIN { printf "%.3f", v * 1.1 }')
  sed -e "s/{{SCAN}}/$scan/" -e "s/{{VIGNETTE}}/$vig/" \
    "$SOURCE_DIR/hypr/crt.frag.tpl" > "$CRT_FRAG.tmp"
  if grep -q "{{" "$CRT_FRAG.tmp"; then
    rm -f "$CRT_FRAG.tmp"
    fail "shader template tokens left unrendered"
  fi
  mv "$CRT_FRAG.tmp" "$CRT_FRAG"
}

# Idempotent: installs the hl.config block when CRT_GLOBAL is true and no
# foreign screen_shader exists, removes it otherwise. Reloads Hyprland
# (safe: reload never restarts shells or terminals). Note: the legacy
# hyprland.conf is NOT read by the lua-driven compositor, so the live path
# is looknfeel.lua via hl.config (merged, nothing else is clobbered).
ensure_crt_snippet() {
  local want="false"
  [[ $(conf_value CRT_GLOBAL true) == true ]] && want="true"
  [[ -f $HYPR_LUA ]] || { printf 'No looknfeel.lua; global CRT skipped.\n' >&2; return; }
  if grep -qF -- "$CRT_BEGIN" "$HYPR_LUA"; then
    [[ $want == true ]] || { remove_crt_snippet; return; }
    # The frag file may have been re-rendered (e.g. intensity changed via
    # hand-edit + apply); reload so Hyprland picks up the new values.
    hyprctl reload >/dev/null
    return
  fi
  [[ $want == true ]] || return
  if grep -rh --exclude="*.bak.*" "screen_shader" "$HOME/.config/hypr/" 2>/dev/null | grep -v "cogitator-v2-crt" | grep -q "screen_shader"; then
    printf 'Foreign screen_shader found; leaving Hyprland config alone.\n' >&2
    return
  fi
  cp -a -- "$HYPR_LUA" "$HYPR_LUA.bak.$(date +%Y%m%d-%H%M%S)"
  cat >> "$HYPR_LUA" <<EOF

$CRT_BEGIN
-- While engaged, every window passes through the Cogitator phosphor
-- treatment. Managed by cogitator-v2; delete this block to opt out.
hl.config({
  decoration = {
    screen_shader = "$CRT_FRAG",
  },
})
$CRT_END
EOF
  hyprctl reload >/dev/null
}

remove_crt_snippet() {
  [[ -f $HYPR_LUA ]] || return 0
  grep -qF -- "$CRT_BEGIN" "$HYPR_LUA" || return 0
  cp -a -- "$HYPR_LUA" "$HYPR_LUA.bak.$(date +%Y%m%d-%H%M%S)"
  awk -v begin="$CRT_BEGIN" -v end="$CRT_END" '
    $0 == begin { skip=1; next }
    $0 == end { skip=0; next }
    !skip { print }
  ' "$HYPR_LUA" > "$HYPR_LUA.tmp"
  mv "$HYPR_LUA.tmp" "$HYPR_LUA"
  hyprctl reload >/dev/null
  printf 'Global CRT treatment removed; stock compositor config restored.\n'
}

# Idempotent: triangular window chamfers (rounding + power 1.0) while
# engaged, removed otherwise. Same marker/backup/reload discipline as CRT.
ensure_window_chamfer() {
  local want="false" corner=14
  [[ $(conf_value WINDOW_CHAMFER true) == true ]] && want="true"
  corner=$(conf_value WINDOW_CORNER 14)
  [[ $corner =~ ^[0-9]+$ ]] || corner=14
  (( corner >= 0 && corner <= 40 )) || corner=14
  [[ -f $HYPR_LUA ]] || { printf 'No looknfeel.lua; window chamfer skipped.\n' >&2; return; }
  if grep -qF -- "$CHAMFER_BEGIN" "$HYPR_LUA"; then
    [[ $want == true ]] || remove_window_chamfer
    return
  fi
  [[ $want == true ]] || return
  cp -a -- "$HYPR_LUA" "$HYPR_LUA.bak.$(date +%Y%m%d-%H%M%S)"
  cat >> "$HYPR_LUA" <<EOF

$CHAMFER_BEGIN
-- Triangular window cuts while engaged (rounding + power 1.0 = chamfered
-- corners; Hyprland exposes no per-corner setting). Managed by
-- cogitator-v2; delete this block to opt out.
hl.config({
  decoration = {
    rounding = $corner,
    rounding_power = 1.0,
  },
})
$CHAMFER_END
EOF
  hyprctl reload >/dev/null
}

remove_window_chamfer() {
  [[ -f $HYPR_LUA ]] || return 0
  grep -qF -- "$CHAMFER_BEGIN" "$HYPR_LUA" || return 0
  cp -a -- "$HYPR_LUA" "$HYPR_LUA.bak.$(date +%Y%m%d-%H%M%S)"
  awk -v begin="$CHAMFER_BEGIN" -v end="$CHAMFER_END" '
    $0 == begin { skip=1; next }
    $0 == end { skip=0; next }
    !skip { print }
  ' "$HYPR_LUA" > "$HYPR_LUA.tmp"
  mv "$HYPR_LUA.tmp" "$HYPR_LUA"
  hyprctl reload >/dev/null
  printf 'Window chamfer removed; stock corners restored.\n'
}

prepare_config() {
  mkdir -p "$CONFIG_DIR" "$CONFIG_DIR/bash" "$HOME/.local/bin"
  [[ -f $CONF_FILE ]] || install -m 0644 "$SOURCE_DIR/config/cogitator.conf.example" "$CONF_FILE"
  # File only, never wired into startup. Sourcing stays a manual operator act.
  install -m 0644 "$SOURCE_DIR/shell/cogitator.bash" "$CONFIG_DIR/bash/cogitator.bash"
  install -m 0755 "$SOURCE_DIR/scripts/cogitator-menu" "$CONFIG_DIR/cogitator-menu"
  # Convenience on PATH; points at this repo, removed on uninstall.
  ln -sf "$SOURCE_DIR/scripts/cogitator" "$HOME/.local/bin/cogitator"
  render_config_json
  render_crt_frag
}

install_keybinding() {
  [[ -f $BINDINGS_FILE ]] || fail "no Hyprland bindings file at $BINDINGS_FILE"
  if grep -qF -- "$BIND_BEGIN" "$BINDINGS_FILE"; then
    printf 'Cogitator SUPER+SPACE route already installed.\n'
    return
  fi
  cp -a -- "$BINDINGS_FILE" "$BINDINGS_FILE.bak.$(date +%Y%m%d-%H%M%S)"
  cat >> "$BINDINGS_FILE" <<EOF

$BIND_BEGIN
-- While engaged, SUPER+SPACE toggles the Application Cogitator; otherwise
-- it falls through to the stock Omarchy menu. Managed by cogitator-v2;
-- delete this block (or run \`cogitator uninstall\`) to restore stock keys.
hl.unbind("SUPER + SPACE")
o.bind("SUPER + SPACE", "Cogitator menu", "$CONFIG_DIR/cogitator-menu")
$BIND_END
EOF
  printf 'SUPER+SPACE now routes via cogitator-menu (backup of bindings saved).\n'
}

remove_keybinding() {
  [[ -f $BINDINGS_FILE ]] || return 0
  grep -qF -- "$BIND_BEGIN" "$BINDINGS_FILE" || return 0
  cp -a -- "$BINDINGS_FILE" "$BINDINGS_FILE.bak.$(date +%Y%m%d-%H%M%S)"
  awk -v begin="$BIND_BEGIN" -v end="$BIND_END" '
    $0 == begin { skip=1; next }
    $0 == end { skip=0; next }
    !skip { print }
  ' "$BINDINGS_FILE" > "$BINDINGS_FILE.tmp"
  mv "$BINDINGS_FILE.tmp" "$BINDINGS_FILE"
  printf 'Cogitator SUPER+SPACE route removed; stock binding restored.\n'
}

queue_transition() {
  systemd-run --user --collect --unit=cogitator-v2-transition "$@" >/dev/null
}

# Herald overlay: while engaged, the notifications clone (created if absent)
# wears the Cogitator card + centered layout. Runs INSIDE the unit.
ensure_herald() {
  local clone_id
  clone_id=$(find_herald_clone)
  if [[ -z $clone_id ]]; then
    omarchy plugin clone "$HERALD_SOURCE"
    clone_id=$(find_herald_clone)
    [[ -n $clone_id ]] || fail "notifications clone did not appear"
  fi
  local clone_dir="$HOME/.config/omarchy/plugins/$clone_id"
  python3 "$SOURCE_DIR/scripts/apply-notification-overlay.py" \
    "$clone_dir/Service.qml" "$SOURCE_DIR/overlays/notifications/NotificationCard.qml"
  printf '%s\n' "$VERSION" > "$clone_dir/$HERALD_MARKER"
}

# Menu overlay: while engaged, the menu clone wears the Cogitator chrome.
# Runs INSIDE the unit.
ensure_menu_overlay() {
  local clone_id
  clone_id=$(find_menu_clone)
  if [[ -z $clone_id ]]; then
    omarchy plugin clone "$MENU_SOURCE"
    clone_id=$(find_menu_clone)
    [[ -n $clone_id ]] || fail "menu clone did not appear"
  fi
  local clone_dir="$HOME/.config/omarchy/plugins/$clone_id"
  cp -a -- "$SOURCE_DIR/overlays/rowdy.menu/Menu.qml" "$clone_dir/Menu.qml"
  printf '%s\n' "$VERSION" > "$clone_dir/$MENU_MARKER"
}

# True when a clone is provably ours: receipt present, or live files
# byte-identical to the repo overlay (receipts can be lost; content can't lie).
# kind: notifications | menu. Pure file logic: safe in tests with fixtures.
clone_is_managed() {
  local kind="$1" dir="$2"
  [[ -d $dir ]] || return 1
  case "$kind" in
    notifications)
      [[ -f $dir/$HERALD_MARKER ]] && return 0
      cmp -s "$SOURCE_DIR/overlays/notifications/NotificationCard.qml" \
        "$dir/components/NotificationCard.qml" || return 1
      grep -qF -- "// cogitator-v2-herald" "$dir/Service.qml"
      ;;
    menu)
      [[ -f $dir/$MENU_MARKER ]] && return 0
      cmp -s "$SOURCE_DIR/overlays/rowdy.menu/Menu.qml" "$dir/Menu.qml"
      ;;
    *) return 1 ;;
  esac
}

# Restore whatever the snapshot captured. Runs INSIDE the detached unit.
restore_menu_overlay() {
  local clone_id="$1" backup="$2"
  if [[ -z $clone_id ]]; then
    # Snapshot predates the clone (created mid-engagement, old format, or
    # interrupted run): discover live and remove only if provably ours.
    clone_id=$(find_menu_clone)
    [[ -n $clone_id ]] || return 0
    backup=""
  fi
  local clone_dir="$HOME/.config/omarchy/plugins/$clone_id"
  if [[ -n $backup && -d $backup ]]; then
    if [[ ! -d $clone_dir ]]; then
      printf 'Clone %s already gone; backup at %s kept, continuing.\n' "$clone_id" "$backup" >&2
      return 0
    fi
    cp -a -- "$backup/Menu.qml" "$clone_dir/Menu.qml"
    rm -f "$clone_dir/$MENU_MARKER"
  else
    if clone_is_managed menu "$clone_dir"; then
      omarchy plugin remove "$clone_id" --yes
    else
      printf 'Clone %s changed out from under us; leaving it alone.\n' "$clone_id" >&2
    fi
  fi
}

# Restore whatever the snapshot captured. Runs INSIDE the detached unit.
restore_herald() {
  local clone_id="$1" backup="$2"
  if [[ -z $clone_id ]]; then
    # Snapshot predates the clone (created mid-engagement, old format, or
    # interrupted run): discover live and remove only if provably ours.
    clone_id=$(find_herald_clone)
    [[ -n $clone_id ]] || return 0
    backup=""
  fi
  local clone_dir="$HOME/.config/omarchy/plugins/$clone_id"
  if [[ -n $backup && -d $backup ]]; then
    # A clone predated us: put the user's own files back.
    if [[ ! -d $clone_dir ]]; then
      printf 'Clone %s already gone; backup at %s kept, continuing.\n' "$clone_id" "$backup" >&2
      return 0
    fi
    cp -a -- "$backup/Service.qml" "$clone_dir/Service.qml"
    cp -a -- "$backup/NotificationCard.qml" "$clone_dir/components/NotificationCard.qml"
    rm -f "$clone_dir/$HERALD_MARKER"
  else
    # We created the clone: remove it when provably ours (receipt or
    # byte-identical content); a hand-modified clone is left alone.
    if clone_is_managed notifications "$clone_dir"; then
      omarchy plugin remove "$clone_id" --yes
    else
      printf 'Clone %s changed out from under us; leaving it alone.\n' "$clone_id" >&2
    fi
  fi
}

# Runs INSIDE the detached unit: native installs, theme set, enable.
_unit_enable() {
  set -euo pipefail
  local plugindir="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
  if omarchy-shell shell listPlugins 2>/dev/null | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id)' >/dev/null 2>&1; then
    if [[ -d $plugindir/.git ]] && owned_by_us "$plugindir"; then
      # Dev copies or interrupted runs can leave tracked modifications or
      # untracked files that collide with incoming paths and block
      # fast-forward; the clone always rebuilds from the repo.
      git -C "$plugindir" checkout -q -- . || true
      git -C "$plugindir" clean -q -fd || true
      printf '%s\n' "$VERSION" > "$plugindir/$MARKER"
      omarchy plugin update "$PLUGIN_ID" --yes
    elif [[ -d $plugindir/.git ]]; then
      fail "plugin dir is a foreign git checkout; remove it manually"
    else
      # Legacy non-git install: native remove backs it up, then fresh add.
      omarchy plugin remove "$PLUGIN_ID" --yes
      omarchy plugin add "$REPO_URL" --yes
    fi
  else
    omarchy plugin add "$REPO_URL" --yes
  fi
  printf '%s\n' "$VERSION" > "$HOME/.config/omarchy/plugins/$PLUGIN_ID/$MARKER"
  rm -rf "$HOME/.config/omarchy/themes/$THEME_SLUG"
  git clone -- "$REPO_URL" "$HOME/.config/omarchy/themes/$THEME_SLUG"
  printf '%s\n' "$VERSION" > "$HOME/.config/omarchy/themes/$THEME_SLUG/$MARKER"
  omarchy theme set "$THEME_SLUG"
  omarchy theme bg set "$HOME/.config/omarchy/themes/$THEME_SLUG/backgrounds/cogitator-green-grid.png"
  omarchy plugin enable "$PLUGIN_ID"
  ensure_herald
  ensure_menu_overlay
  # Service-kind plugins only reload on a full shell restart; rescan is not
  # enough (stale service keeps serving old IPC surface).
  omarchy restart shell
}

# Runs INSIDE the detached unit: disable plugin, restore theme, clear snapshot.
_unit_disable() {
  set -euo pipefail
  local plugin_dst="$1" theme_dst="$2" previous="$3" previous_bg="$4" snapshot="$5" herald_clone="${6:-}" herald_backup="${7:-}" menu_clone="${8:-}" menu_backup="${9:-}"
  restore_herald "$herald_clone" "$herald_backup"
  restore_menu_overlay "$menu_clone" "$menu_backup"
  if [[ -f $plugin_dst/$MARKER ]]; then
    omarchy plugin disable "$PLUGIN_ID" || true
  else
    echo "Plugin install not ours; leaving files, only restoring theme selection." >&2
  fi
  remove_crt_snippet || true
  remove_window_chamfer || true
  omarchy theme set "$previous"
  if [[ -n $previous_bg ]]; then omarchy theme bg set "$previous_bg" || true; fi
  omarchy restart shell
  rm -f "$snapshot"
}

cmd_status() {
  if [[ ${1:-} == --json ]]; then
    jq -n --arg theme "$(current_theme)" \
      --arg palette "$([[ -f $CONF_FILE ]] && conf_value PALETTE green || printf green)" \
      --argjson plugin "$(plugin_enabled && printf true || printf false)" \
      --argjson installed "$([[ -f $PLUGIN_DST/manifest.json && -f $THEME_DST/colors.toml ]] && printf true || printf false)" \
      --argjson snapshot "$([[ -f $SNAPSHOT ]] && printf true || printf false)" \
      '{theme: $theme, palette: $palette, pluginEnabled: $plugin, installed: $installed, snapshot: $snapshot, version: $version}' \
      --arg version "$VERSION"
    return
  fi
  printf 'COGITATOR-V2 %s\nTHEME: %s\nPALETTE: %s\nPLUGIN %s: %s\nSNAPSHOT: %s\n' \
    "$VERSION" "$(current_theme)" "$([[ -f $CONF_FILE ]] && conf_value PALETTE green || printf green)" "$PLUGIN_ID" \
    "$(plugin_enabled && printf ENABLED || printf disabled)" \
    "$([[ -f $SNAPSHOT ]] && printf armed || printf none)"
}

cmd_enable() {
  local current
  current=$(current_theme)
  [[ -d $SOURCE_DIR/.git ]] || fail "repo is not a git checkout; native install needs one"
  if [[ -f $SNAPSHOT ]]; then
    printf 'Snapshot exists; re-applying without overwriting it.\n'
  else
    write_snapshot "$current"
    printf 'Snapshot armed. Previous theme: %s\n' "${current:-unknown}"
  fi
  prepare_config
  omarchy plugin validate "$SOURCE_DIR" >/dev/null
  install_keybinding
  ensure_crt_snippet
  ensure_window_chamfer
  queue_transition bash -c 'source "$0/scripts/cogitator" --unit-enable' "$SOURCE_DIR"
  printf 'Transition queued. Theme/plugin apply in background; check `cogitator status`.\nDisable any time: cogitator disable\n'
}

# Repair mode: no snapshot means disengaged, but styled clones may linger
# from history. Remove only provably-ours clones so menus return to stock;
# hand-modified clones are reported and left alone.
repair_menus_to_stock() {
  local kind src clone_id clone_dir removed=0
  for kind in notifications menu; do
    if [[ $kind == notifications ]]; then src="$HERALD_SOURCE"; else src="$MENU_SOURCE"; fi
    clone_id=$(find_clone "$src")
    [[ -n $clone_id ]] || continue
    clone_dir="$HOME/.config/omarchy/plugins/$clone_id"
    if clone_is_managed "$kind" "$clone_dir"; then
      printf 'Removing managed %s clone; stock %s resumes.\n' "$clone_id" "$src"
      omarchy plugin remove "$clone_id" --yes
      removed=1
    else
      printf 'Clone %s differs from the overlay; leaving it alone.\n' "$clone_id" >&2
    fi
  done
  if (( removed )); then
    omarchy restart shell
    printf 'Menus restored to stock.\n'
  else
    printf 'Already disengaged; menus already stock.\n'
  fi
}

cmd_disable() {
  local previous previous_bg
  [[ -f $SNAPSHOT ]] || { repair_menus_to_stock; return; }
  previous=$(jq -r '.previousTheme // ""' "$SNAPSHOT")
  previous_bg=$(jq -r '.previousBackground // ""' "$SNAPSHOT")
  [[ -n $previous ]] || fail "snapshot has no previous theme; refusing to guess"
  herald_clone=$(jq -r '.heraldClone // ""' "$SNAPSHOT")
  herald_backup=$(jq -r '.heraldBackup // ""' "$SNAPSHOT")
  menu_clone=$(jq -r '.menuClone // ""' "$SNAPSHOT")
  menu_backup=$(jq -r '.menuBackup // ""' "$SNAPSHOT")
  queue_transition bash -c 'source "$0/scripts/cogitator" --unit-disable "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9"' \
    "$SOURCE_DIR" "$PLUGIN_DST" "$THEME_DST" "$previous" "$previous_bg" "$SNAPSHOT" "$herald_clone" "$herald_backup" "$menu_clone" "$menu_backup"
  printf 'Restore queued. Previous theme (%s) returns in background; snapshot clears on completion.\n' "$previous"
}

cmd_palette() {
  local name="${1:-}"
  case "$name" in
    green|amber|red|industrial|custom) ;;
    *) fail "usage: cogitator palette <green|amber|red|industrial|custom>" ;;
  esac
  [[ -f $SNAPSHOT ]] || fail "engage first: cogitator enable"
  local slug="cogitator-$name" src="$SOURCE_DIR/themes/cogitator-$name"
  if [[ $name == green ]]; then
    src="$SOURCE_DIR"
  elif [[ $name == custom ]]; then
    local hex
    hex=$(conf_value CUSTOM_PHOSPHOR "")
    [[ -n $hex ]] || fail "set CUSTOM_PHOSPHOR (e.g. \"#7CFF6B\") in $CONF_FILE first"
    python3 "$SOURCE_DIR/palettes/render.py" custom --phosphor "$hex" || fail "custom render failed"
  else
    [[ -d $src ]] || fail "palette theme missing from repo; render first"
  fi
  set_conf PALETTE "$name"
  prepare_config
  queue_transition bash -c '
    set -euo pipefail
    slug="$1"; src="$2"; dst="$HOME/.config/omarchy/themes/$slug"
    rm -rf "$dst"
    mkdir -p "$dst"
    if [[ "$src" == */themes/* ]]; then cp -a "$src/." "$dst/"; else cp -a "$src/colors.toml" "$src/shell.toml" "$src/icons.theme" "$src/backgrounds" "$dst/"; fi
    printf "%s\n" "0.3.0" > "$dst/.cogitator-v2-installed"
    omarchy theme set "$slug"
    omarchy theme bg set "$dst/backgrounds/$slug-grid.png"
    omarchy-shell -q shell rescanPlugins
  ' _ "$slug" "$src"
  printf 'Palette %s queued. Shell surfaces follow the theme file live.\n' "$name"
}

cmd_apply() {
  render_config_json && omarchy restart shell && printf 'Config applied.\n'
}

cmd_configure() {
  [[ -f $CONF_FILE ]] || { mkdir -p "$CONFIG_DIR"; install -m 0644 "$SOURCE_DIR/config/cogitator.conf.example" "$CONF_FILE"; }
  local before="" after=""
  before=$(sha256sum < "$CONF_FILE")
  "${EDITOR:-nano}" "$CONF_FILE"
  after=$(sha256sum < "$CONF_FILE")
  if [[ $before != "$after" ]]; then
    printf 'Configuration changed; applying.\n'
    cmd_apply
  else
    printf 'No changes; shell untouched.\n'
  fi
}

cmd_uninstall() {
  if [[ -f $SNAPSHOT ]]; then
    cmd_disable
    printf 'Re-run `cogitator uninstall%s` after the restore completes.\n' "${1:+ $1}"
    return
  fi
  if owned_by_us "$PLUGIN_DST"; then
    omarchy plugin remove "$PLUGIN_ID" --yes
  elif [[ -e $PLUGIN_DST ]]; then
    fail "plugin dir exists but is not ours; remove it manually"
  fi
  if owned_by_us "$THEME_DST"; then
    omarchy theme remove "$THEME_SLUG"
  elif [[ -e $THEME_DST ]]; then
    fail "theme dir exists but is not ours; remove it manually"
  fi
  local extra
  for extra in "$HOME/.config/omarchy/themes"/cogitator-*/; do
    [[ -d $extra ]] || continue
    if [[ -f ${extra%/}/$MARKER ]]; then
      omarchy theme remove "$(basename "${extra%/}")"
    fi
  done
  if [[ -L $HOME/.local/bin/cogitator && $(readlink "$HOME/.local/bin/cogitator") == "$SOURCE_DIR/scripts/cogitator" ]]; then
    rm -f "$HOME/.local/bin/cogitator"
  fi
  remove_crt_snippet || true
  remove_window_chamfer || true
  remove_keybinding
  if [[ ${1:-} == --purge ]]; then
    rm -rf "$CONFIG_DIR" "$STATE_DIR"
    printf 'Configuration purged.\n'
  else
    printf 'Removed package files. Config preserved at %s.\n' "$CONFIG_DIR"
  fi
}

case "${1:-}" in
  --unit-enable) _unit_enable ;;
  --unit-disable) _unit_disable "$2" "$3" "$4" "$5" "$6" "${7:-}" "${8:-}" "${9:-}" "${10:-}" ;;
  status) cmd_status "${2:-}" ;;
  enable) cmd_enable ;;
  disable) cmd_disable ;;
  toggle)
    if plugin_enabled || [[ $(current_theme) == *cogitator* ]]; then cmd_disable; else cmd_enable; fi
    ;;
  apply) prepare_config && ensure_crt_snippet && ensure_window_chamfer; cmd_apply ;;
  configure) cmd_configure ;;
  palette) cmd_palette "${2:-}" ;;
  uninstall) cmd_uninstall "${2:-}" ;;
  -h|--help|help)
    printf 'Usage: cogitator <status|enable|disable|toggle|apply|configure|palette|uninstall>\nNative equivalents: omarchy plugin add|update|remove %s, omarchy theme install|set|remove\n' "$PLUGIN_ID"
    ;;
  *) printf 'Usage: cogitator <status|enable|disable|toggle|apply|configure|palette|uninstall>\n' >&2; exit 1 ;;
esac
