#!/bin/bash
# SUPER+SPACE router for Cogitator v2. While the rite is engaged (snapshot
# present) it toggles the Application Cogitator; otherwise it falls through
# to the stock Omarchy menu. COGITATOR_SNAPSHOT overrides the journal path
# (used by tests to exercise both branches without touching live state).
set -euo pipefail

snapshot="${COGITATOR_SNAPSHOT:-${XDG_STATE_HOME:-$HOME/.local/state}/cogitator-v2/snapshot.json}"

if [[ -f $snapshot ]]; then
  exec omarchy-shell cogitator-rite toggleLauncher
else
  exec omarchy-menu toggle
fi
