#!/bin/bash
# Target the enabled themed menu explicitly: host updates need not redirect
# the default menu to its clone. Keep stock routing when disengaged.
set -euo pipefail

# Hyprland exec dispatch does not inherit the session environment that
# terminals enjoy; omarchy-shell refuses to run without OMARCHY_PATH.
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

if [[ ${1:-} == apps ]]; then
  if omarchy-shell shell listPlugins 2>/dev/null \
      | jq -e 'any(.[]; .id == "cogitator-rite" and .enabled == true)' >/dev/null; then
    exec omarchy-shell cogitator-rite toggleLauncher
  fi
  exec omarchy-shell omarchy.dock apps
fi

if omarchy-shell shell listPlugins 2>/dev/null \
    | jq -e 'any(.[]; .id == "cogitator.menu" and .enabled == true)' >/dev/null; then
  exec omarchy-shell shell toggle cogitator.menu '{"menu":"root"}'
fi
exec omarchy-menu toggle
