#!/bin/bash
# SUPER+SPACE uses the native menu lifecycle. While engaged the shell resolves
# omarchy.menu to cogitator.menu, retaining global app/command/provider search
# and the user's JSONC extensions. When disengaged it resolves to stock.
set -euo pipefail

# Hyprland exec dispatch does not inherit the session environment that
# terminals enjoy; omarchy-shell refuses to run without OMARCHY_PATH.
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"

exec omarchy-menu toggle
