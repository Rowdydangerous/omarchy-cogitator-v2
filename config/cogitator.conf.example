# Single centralized config. Copy to ~/.config/cogitator-v2/cogitator.conf on enable.
# green | amber | red | industrial | custom. Switch live with
# `cogitator palette <name>` (custom derives from CUSTOM_PHOSPHOR).
PALETTE="green"
CUSTOM_PHOSPHOR=""

CRT_ENABLED=true
# Global phosphor treatment: every window passes through the compositor
# screen shader (static scanlines + vignette, zero continuous GPU cost).
CRT_GLOBAL=true
SCANLINES=true
PHOSPHOR_GLOW=0.35
BLOOM=0.20
VIGNETTE=true
FLICKER=0.05
NOISE=0.03
PERSISTENCE=0.15
GHOSTING=0.10
BRIGHTNESS_FALLOFF=true
SCREEN_BURN=false
CRT_INTENSITY=0.25

BACKGROUND_BURN=true
BACKGROUND_BURN_OPACITY=0.08
BACKGROUND_DATA_DENSITY=0.35
BACKGROUND_ANIMATION_SPEED=0.20

HOLOGRAPHIC_EFFECTS=true
# full: every effect. normal: sweep + streaming, no flicker/grain.
# minimal: frozen consoles (telemetry text still updates).
ANIMATION_LEVEL="full"

TEXT_STREAMING=true
TEXT_SPEED="normal"
WORKSPACE_RITES=true

COGITATOR_PROP=true
COGITATOR_PROP_POSITION="right"
COGITATOR_PROP_OPACITY=0.92
