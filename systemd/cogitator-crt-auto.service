[Unit]
Description=Cogitator CRT auto-suspend while a video is fullscreen
Documentation=file:%h/.config/cogitator-v2/cogitator.conf
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/cogitator-v2/crt-auto.py
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
